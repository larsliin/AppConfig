{
  "manifest_version": 3,
  "name": "Config Copier",
  "version": "1.0.0",
  "description": "Copy configuration from downloaded config files to clipboard",
  "permissions": [
    "activeTab",
    "declarativeContent",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-disabled-16.png",
      "48": "icons/icon-disabled-48.png",
      "128": "icons/icon-disabled-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Catalyst appConfig copier"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
